function checkout() {
    let total = parseFloat(document.getElementById("total").innerText);
    let paid = parseFloat(document.getElementById("amountPaid").value);
    
    if (cart.length === 0) { alert("Cart is empty."); return; }
    if (!paid || paid < total) { alert("Invalid payment amount."); return; }

    fetch("pos_checkout.php", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cart: cart, total: total, paid: paid, change: paid - total })
    })
    .then(response => response.json())
    .then(data => {
        if (data.status === "success") {
            printReceipt(data.transaction_id);
            setTimeout(() => location.reload(), 1000);
        } else {
            alert(data.message);
        }
    })
    .catch(error => { console.error(error); alert("Checkout failed."); });
}
function filterProducts() {
    // Kunin ang tinype ng user at gawing lowercase
    let searchInput = document.getElementById("liveSearch").value.toLowerCase();
    
    // Kunin ang lahat ng product items sa page
    let products = document.querySelectorAll(".product-item");

    // I-loop ang bawat product para i-check kung tugma sa hinahanap
    products.forEach(product => {
        let productName = product.getAttribute("data-name");
        
        if (productName.includes(searchInput)) {
            // Ipakita ang product kung may match
            product.style.display = ""; 
        } else {
            // Itago ang product kung walang match
            product.style.display = "none"; 
        }
    });
}
