<?php
session_start();
include "../config/db.php";

$message = "";
$message_type = "";

// ========================================================
// API ENDPOINT: LIVE FETCH OF ITEMS, VARIANTS & STORE PRODUCTS
// ========================================================
if (isset($_GET['action']) && $_GET['action'] === 'get_items') {
    header('Content-Type: application/json');
    $order_id = mysqli_real_escape_string($conn, trim($_GET['order_id'] ?? ''));
    $email = mysqli_real_escape_string($conn, trim($_GET['email'] ?? ''));
    
    $check = mysqli_query($conn, "SELECT id, status FROM orders WHERE id = '$order_id' AND email = '$email' LIMIT 1");
    if ($check && mysqli_num_rows($check) > 0) {
        $order_data = mysqli_fetch_assoc($check);

        $items_query = mysqli_query($conn, "SELECT oi.product_id, oi.qty, 
                                            COALESCE(NULLIF(pv.variant_name, ''), p.product_name) AS product_name, 
                                            COALESCE(pv.price, p.price) AS price 
                                            FROM order_items oi 
                                            JOIN products p ON oi.product_id = p.id
                                            LEFT JOIN product_variants pv ON oi.variant_id = pv.id 
                                            WHERE oi.order_id = '{$order_data['id']}'");

        $items = [];
        while ($row = mysqli_fetch_assoc($items_query)) {
            $items[] = $row;
        }

        // Kunin ang lahat ng available products sa shop para sa exchange selection (Variant name lang)
        $all_products_query = mysqli_query($conn, "SELECT pv.id, 
                                                   COALESCE(NULLIF(pv.variant_name, ''), p.product_name) AS product_name, 
                                                   pv.price 
                                                   FROM product_variants pv
                                                   JOIN products p ON pv.product_id = p.id
                                                   WHERE pv.stock > 0 
                                                   ORDER BY p.product_name ASC, pv.variant_name ASC");
        $shop_products = [];
        while ($p = mysqli_fetch_assoc($all_products_query)) {
            $shop_products[] = $p;
        }

        echo json_encode([
            'success' => true, 
            'status' => $order_data['status'], 
            'items' => $items,
            'shop_products' => $shop_products
        ]);
        exit;
    } else {
        echo json_encode(['success' => false, 'message' => 'Order not found with matching email.']);
        exit;
    }
}

// ========================================================
// POST HANDLER: SUBMISSION OF REQUESTS (WITH TOTAL PRICE LOGIC)
// ========================================================
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['submit_request'])) {
    $order_id = mysqli_real_escape_string($conn, trim($_POST['order_id']));
    $email = mysqli_real_escape_string($conn, trim($_POST['email']));
    $request_type = mysqli_real_escape_string($conn, $_POST['request_type']);
    $reason = mysqli_real_escape_string($conn, $_POST['reason'] ?? '');
    
    $user_comments = trim($_POST['details'] ?? '');
    $item_replaced_val = '';
    $item_exchange_val = '';
    $comment_val = $user_comments;

    $ver_query = mysqli_query($conn, "SELECT status FROM orders WHERE id = '$order_id' AND email = '$email' LIMIT 1");
    if ($ver_query && mysqli_num_rows($ver_query) > 0) {
        $v_data = mysqli_fetch_assoc($ver_query);
        $v_status = strtolower(trim($v_data['status']));

        if ($request_type === 'exchange' && $v_status !== 'completed') {
            $message = "❌ Cannot request exchange. Item Exchange is only allowed for COMPLETED orders.";
            $message_type = "danger";
        } 
        elseif ($request_type === 'cancel' && ($v_status === 'out for delivery' || $v_status === 'completed' || $v_status === 'delivered')) {
            $message = "❌ Cannot request cancellation. Order status is " . strtoupper($v_data['status']) . ".";
            $message_type = "danger";
        } else {
            $filename = "";
            if (isset($_FILES['product_image']) && $_FILES['product_image']['error'] === 0) {
                $ext = pathinfo($_FILES['product_image']['name'], PATHINFO_EXTENSION);
                $filename = "REQ_" . time() . "_" . rand(1000, 9999) . "." . $ext;
                move_uploaded_file($_FILES['product_image']['tmp_name'], "../uploads/" . $filename);
            }

            if ($request_type === 'exchange') {
                $return_qty = (int)($_POST['return_item_qty'] ?? 1);
                $old_item_name = trim($_POST['exchange_old_item_name'] ?? 'Selected Item');
                $old_item_unit_price = (float)($_POST['exchange_old_item_price'] ?? 0);
                $old_total_price = $old_item_unit_price * $return_qty;
                
                // Format: item x2 total:440
                $item_replaced_val = "{$old_item_name} x{$return_qty} total: " . number_format($old_total_price, 2, '.', '');
                
                $exchange_summary = "";
                if (isset($_POST['exchange_products'])) {
                    foreach ($_POST['exchange_products'] as $index => $variant_id) {
                        $qty = (int)$_POST['exchange_qtys'][$index];
                        $prod_query = mysqli_query($conn, "SELECT CONCAT(p.product_name, ' - ', pv.variant_name) AS full_vname, pv.price 
                                                            FROM product_variants pv 
                                                            JOIN products p ON pv.product_id = p.id 
                                                            WHERE pv.id = '$variant_id' LIMIT 1");
                        if ($prod_query && $prod_row = mysqli_fetch_assoc($prod_query)) {
                            $line_total = (float)$prod_row['price'] * $qty;
                            $exchange_summary .= "{$prod_row['full_vname']} x{$qty} total: " . number_format($line_total, 2, '.', '') . " | ";
                        }
                    }
                }
                $item_exchange_val = trim($exchange_summary, " | ");
            }

            $comment_escaped = mysqli_real_escape_string($conn, $comment_val);
            $replaced_escaped = mysqli_real_escape_string($conn, $item_replaced_val);
            $exchange_escaped = mysqli_real_escape_string($conn, $item_exchange_val);

            $ins = mysqli_query($conn, "INSERT INTO customer_requests (order_number, account, request_type, reason, details, item_to_replace, item_to_exchange, product_image, status) 
                                        VALUES ('$order_id', '$email', '$request_type', '$reason', '$comment_escaped', '$replaced_escaped', '$exchange_escaped', " . ($filename ? "'$filename'" : "NULL") . ", 'Pending')");
            if ($ins) {
                $message = "🎉 Your ticket request (" . strtoupper($request_type) . ") has been submitted successfully! Admin will review it.";
                $message_type = "success";
            } else {
                $message = "❌ Failed to submit request. Please try again.";
                $message_type = "danger";
            }
        }
    } else {
        $message = "❌ Verification error. Order connection lost.";
        $message_type = "danger";
    }
}
