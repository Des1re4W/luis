<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
let verifiedItemsData = [];
let shopProductsData = [];

document.getElementById('btnVerify').addEventListener('click', function() {
    const orderId = document.getElementById('order_id').value.trim();
    const email = document.getElementById('email').value.trim();
    const errorWrapper = document.getElementById('errorWrapper');
    const formBodyWrapper = document.getElementById('formBodyWrapper');

    if(!orderId || !email) {
        alert("Please enter both Order ID and Email address.");
        return;
    }

    fetch(`customerService.php?action=get_items&order_id=${orderId}&email=${email}`)
    .then(res => res.json())
    .then(data => {
        if(data.success) {
            errorWrapper.classList.add('d-none');
            formBodyWrapper.classList.remove('d-none');
            verifiedItemsData = data.items;
            shopProductsData = data.shop_products;
            handleFormTypeSetup(data.status);
        } else {
            formBodyWrapper.classList.add('d-none');
            errorWrapper.classList.remove('d-none');
            errorWrapper.innerHTML = `<strong>Error:</strong> ${data.message}`;
        }
    })
    .catch(err => {
        console.error(err);
        alert("An error occurred during verification lookup.");
    });
});

function handleFormTypeSetup(status) {
    const currentStatus = status.toLowerCase().trim();
    const reqCancel = document.getElementById('req_cancel');
    const reqExchange = document.getElementById('req_exchange');
    const lblExchange = document.getElementById('lbl_req_exchange');
    const errorWrapper = document.getElementById('errorWrapper');
    
    errorWrapper.classList.add('d-none');

    if (currentStatus === 'completed') {
        reqExchange.disabled = false;
        lblExchange.classList.remove('disabled', 'btn-outline-secondary');
        lblExchange.classList.add('btn-outline-primary');
        reqExchange.checked = true; 
    } else {
        reqExchange.disabled = true;
        lblExchange.classList.add('disabled');
        reqExchange.checked = false;
        reqCancel.checked = true;

        errorWrapper.classList.remove('d-none');
        errorWrapper.innerHTML = `ℹ️ Your order is currently <strong>${currentStatus.toUpperCase()}</strong>. Item Exchange requests can only be submitted after your order has been delivered and its status has been updated to <strong>COMPLETED</strong>.`;
    }

    if (currentStatus === 'out for delivery' || currentStatus === 'completed' || currentStatus === 'delivered') {
        reqCancel.disabled = true;
        if (currentStatus !== 'completed') {
            errorWrapper.classList.remove('d-none');
            errorWrapper.innerHTML = `ℹ️ Order status is <strong>${status.toUpperCase()}</strong>. Cancellation option is locked.`;
        }
    } else {
        reqCancel.disabled = false;
    }

    renderReasonOptions();
    setupExchangeDropdowns();
}

function renderReasonOptions() {
    const reasonSelect = document.getElementById('requestReason');
    const selectedRadio = document.querySelector('input[name="request_type"]:checked');
    const selectedType = selectedRadio ? selectedRadio.value : 'others';
    
    const reasonFieldWrapper = document.getElementById('reasonFieldWrapper');
    const photoUploadSection = document.getElementById('photoUploadSection');
    const exchangeCalculatorWrapper = document.getElementById('exchangeCalculatorWrapper');
    const lblDetailsDesc = document.getElementById('lbl_details_desc');
    const txtDetails = document.getElementById('requestDetails');
    const productImageInput = document.getElementById('product_image');
    
    reasonSelect.innerHTML = "";
    let options = [];

    reasonFieldWrapper.classList.remove('d-none');
    photoUploadSection.classList.add('d-none');
    exchangeCalculatorWrapper.classList.add('d-none');
    productImageInput.removeAttribute('required');
    lblDetailsDesc.textContent = "Additional Comments / Specific Details";
    txtDetails.placeholder = "Explain your concern comprehensively...";

    if(selectedType === 'exchange') {
        options = ["Wrong size/variant selected", "Received Damaged / Broken Item", "Wrong item delivered", "Other"];
        photoUploadSection.classList.remove('d-none');
        exchangeCalculatorWrapper.classList.remove('d-none');
        productImageInput.setAttribute('required', 'required');
    } else if(selectedType === 'cancel') {
        options = ["Found mistake in order details", "Change of mind", "Accidental order placement","Other"];
    }

    options.forEach(opt => {
        let el = document.createElement('option');
        el.value = opt;
        el.textContent = opt;
        reasonSelect.appendChild(el);
    });
}

document.querySelectorAll('input[name="request_type"]').forEach(radio => {
    radio.addEventListener('change', function() {
        renderReasonOptions();
        runMultiExchangeCalculation();
    });
});

function setupExchangeDropdowns() {
    const oldSelect = document.getElementById('exch_old_item');
    oldSelect.innerHTML = "";

    if (verifiedItemsData.length === 0) {
        let opt = document.createElement('option');
        opt.textContent = "No items found or loaded";
        oldSelect.appendChild(opt);
        return;
    }

    verifiedItemsData.forEach(item => {
        let opt = document.createElement('option');
        
        let itemPrice = parseFloat(item.price) || 0; 
        
        opt.value = itemPrice; 
        opt.setAttribute('data-max-qty', item.qty);
        opt.setAttribute('data-product-name', item.product_name);
        opt.textContent = `${item.product_name} (Unit: ₱${itemPrice.toFixed(2)} - Max Qty: ${item.qty})`;
        oldSelect.appendChild(opt);
    });

    oldSelect.addEventListener('change', function() {
        updateSelectedOldItemData();
        updateMaxReturnQty();
    });

    const returnQtyField = document.getElementById('return_item_qty');
    returnQtyField.addEventListener('input', updateMaxReturnQty);
    
    updateSelectedOldItemData();
    updateMaxReturnQty();
    document.getElementById('exchangeRowsContainer').innerHTML = "";
    addExchangeRow();
}

function updateSelectedOldItemData() {
    const oldSelect = document.getElementById('exch_old_item');
    const hiddenNameInput = document.getElementById('exchange_old_item_name');
    const hiddenPriceInput = document.getElementById('exchange_old_item_price');
    
    if(oldSelect.options.length > 0 && oldSelect.selectedIndex !== -1) {
        const selectedOpt = oldSelect.options[oldSelect.selectedIndex];
        hiddenNameInput.value = selectedOpt.getAttribute('data-product-name') || selectedOpt.text;
        hiddenPriceInput.value = oldSelect.value;
    }
}

function updateMaxReturnQty() {
    const oldSelect = document.getElementById('exch_old_item');
    const qtyInput = document.getElementById('return_item_qty');
    
    if(oldSelect.options.length > 0 && oldSelect.value !== "") {
        const selectedOpt = oldSelect.options[oldSelect.selectedIndex];
        const maxQty = parseInt(selectedOpt.getAttribute('data-max-qty') || 1);
        qtyInput.setAttribute('max', maxQty);
        if(parseInt(qtyInput.value) > maxQty) {
            qtyInput.value = maxQty;
        }
    }
    updateSelectedOldItemData();
    runMultiExchangeCalculation();
}

document.getElementById('btnAddExchangeRow').addEventListener('click', addExchangeRow);

function addExchangeRow() {
    const container = document.getElementById('exchangeRowsContainer');
    const rowIndex = container.children.length;

    let rowHtml = document.createElement('div');
    rowHtml.className = "row g-2 mb-2 align-items-center exchange-row";
    
    let productOptions = "";
    shopProductsData.forEach(p => {
        productOptions += `<option value="${p.id}" data-price="${p.price}">${p.product_name} (₱${parseFloat(p.price).toFixed(2)})</option>`;
    });

    rowHtml.innerHTML = `
        <div class="col-md-7">
            <select name="exchange_products[]" class="form-select cmb-exchange-product">${productOptions}</select>
        </div>
        <div class="col-md-3">
            <input type="number" name="exchange_qtys[]" class="form-control txt-exchange-qty" value="1" min="1">
        </div>
        <div class="col-md-2 text-end">
            <button type="button" class="btn btn-sm btn-danger btn-remove-row w-100" ${rowIndex === 0 ? 'disabled' : ''}><i class="bi bi-trash"></i></button>
        </div>
    `;

    container.appendChild(rowHtml);

    rowHtml.querySelector('.cmb-exchange-product').addEventListener('change', runMultiExchangeCalculation);
    rowHtml.querySelector('.txt-exchange-qty').addEventListener('input', runMultiExchangeCalculation);
    rowHtml.querySelector('.btn-remove-row').addEventListener('click', function() {
        rowHtml.remove();
        runMultiExchangeCalculation();
    });

    runMultiExchangeCalculation();
}

function runMultiExchangeCalculation() {
    const selectedRadio = document.querySelector('input[name="request_type"]:checked');
    const requestType = selectedRadio ? selectedRadio.value : 'others';
    const submitBtn = document.getElementById('btnSubmitForm');
    
    if(requestType !== 'exchange') {
        submitBtn.removeAttribute('disabled');
        return;
    }

    const oldSelect = document.getElementById('exch_old_item');
    if(!oldSelect || oldSelect.options.length === 0 || oldSelect.value === "No items found or loaded") {
        submitBtn.setAttribute('disabled', 'disabled');
        return;
    }

    const unitPrice = parseFloat(oldSelect.value || 0);
    const returnQty = parseInt(document.getElementById('return_item_qty').value || 1);
    const oldTotalVal = unitPrice * returnQty;
    document.getElementById('lbl_old_val').textContent = `₱${oldTotalVal.toFixed(2)}`;

    let totalNewVal = 0;
    document.querySelectorAll('.exchange-row').forEach(row => {
        const productSelect = row.querySelector('.cmb-exchange-product');
        const qtyInput = row.querySelector('.txt-exchange-qty');
        if (productSelect && qtyInput) {
            const selectedOpt = productSelect.options[productSelect.selectedIndex];
            if(selectedOpt) {
                totalNewVal += (parseFloat(selectedOpt.getAttribute('data-price') || 0) * parseInt(qtyInput.value || 0));
            }
        }
    });

    document.getElementById('lbl_new_val').textContent = `₱${totalNewVal.toFixed(2)}`;

    const statusLabel = document.getElementById('lbl_calc_status');
    const resultLabel = document.getElementById('lbl_calc_result');
    const warningNotice = document.getElementById('exchangeWarningNotice');
    const successNotice = document.getElementById('exchangeSuccessNotice');
    const diff = totalNewVal - oldTotalVal;

    if(diff > 0) {
        statusLabel.textContent = "❌ PRICE EXCEEDED:";
        resultLabel.textContent = `+ ₱${diff.toFixed(2)} (OVER BUDGET)`;
        resultLabel.className = "text-danger fw-bold fs-5";
        warningNotice.classList.remove('d-none');
        successNotice.classList.add('d-none');
        submitBtn.setAttribute('disabled', 'disabled');
    } else if(diff < 0) {
        statusLabel.textContent = "NO CASH REFUND! (REMAINING):";
        resultLabel.textContent = `₱${Math.abs(diff).toFixed(2)}`;
        resultLabel.className = "text-warning fw-bold fs-5";
        warningNotice.classList.add('d-none');
        successNotice.classList.remove('d-none');
        submitBtn.removeAttribute('disabled');
    } else {
        statusLabel.textContent = "EVEN EXCHANGE:";
        resultLabel.textContent = "₱0.00 (Perfect Match)";
        resultLabel.className = "text-success fw-bold fs-5";
        warningNotice.classList.add('d-none');
        successNotice.classList.add('d-none');
        submitBtn.removeAttribute('disabled');
    }
}
</script>
